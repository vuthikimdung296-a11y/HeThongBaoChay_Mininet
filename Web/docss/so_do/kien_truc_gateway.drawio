<mxfile host="app.diagrams.net"><diagram name="Muc 2.2.1" id="arch"><mxGraphModel dx="1600" dy="800" grid="1" gridSize="10" page="1" pageWidth="1600" pageHeight="800"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="&lt;b&gt;Cảm biến khói/nhiệt ×300&lt;/b&gt;&lt;br&gt;VLAN 10 · MQTT TCP 1883&lt;br&gt;Báo cháy: DSCP 48 (CS6), QoS 1&lt;br&gt;Telemetry: DSCP 0, 30 s/lần" style="rounded=1;arcSize=6;verticalAlign=top;whiteSpace=wrap;html=1;fillColor=#EEF1F5;strokeColor=#5B6570;fontSize=14;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="230" height="110" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Camera IP ×20&lt;/b&gt;&lt;br&gt;VLAN 20 · RTSP/UDP&lt;br&gt;~4 Mbps/camera (≈80 Mbps)" style="rounded=1;arcSize=6;verticalAlign=top;whiteSpace=wrap;html=1;fillColor=#EEF1F5;strokeColor=#5B6570;fontSize=14;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="20" y="200" width="230" height="100" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;OVS s1&lt;/b&gt;&lt;br&gt;Switch ảo&lt;br&gt;VLAN access&lt;br&gt;trunk → gw" style="rounded=1;arcSize=6;verticalAlign=top;whiteSpace=wrap;html=1;fillColor=#EEF1F5;strokeColor=#5B6570;fontSize=13;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="285" y="110" width="110" height="130" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Kẻ tấn công (mạng ngoài)&lt;/b&gt;&lt;br&gt;192.168.100.100&lt;br&gt;SYN Flood / UDP Flood&lt;br&gt;có thể giả mạo IP nguồn" style="rounded=1;arcSize=6;verticalAlign=top;whiteSpace=wrap;html=1;fillColor=#FBE4E4;strokeColor=#C93A3A;fontSize=14;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="20" y="430" width="230" height="110" as="geometry"/></mxCell><mxCell id="c7" value="" style="rounded=1;arcSize=6;dashed=1;verticalAlign=top;whiteSpace=wrap;html=1;fillColor=#F7F9FC;strokeColor=#9AA5B1;fontSize=14;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="430" y="20" width="930" height="760" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;GIAI ĐOẠN 1 · Tiếp nhận&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F7F9FC;strokeColor=#9AA5B1;fontSize=14;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="450" y="42" width="220" height="34" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;GIAI ĐOẠN 2 · Edge AI phân loại&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF1D6;strokeColor=#D98A00;fontSize=14;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="700" y="42" width="270" height="34" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;GIAI ĐOẠN 3 · Tường lửa &amp;amp; QoS&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E2F3E9;strokeColor=#1E8E4E;fontSize=14;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1000" y="42" width="340" height="34" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Thu thập lưu lượng vào&lt;/b&gt;&lt;br&gt;&lt;br&gt;gw-eth0: trunk VLAN 10/20/30&lt;br&gt;(cảm biến, camera, máy chủ)&lt;br&gt;&lt;br&gt;gw-eth1: phía mạng ngoài&lt;br&gt;(kẻ tấn công)&lt;br&gt;&lt;br&gt;Chỉ bắt chiều VÀO&lt;br&gt;(AF_PACKET), bỏ gói do&lt;br&gt;chính Gateway gửi ra&lt;br&gt;→ mỗi gói chỉ đếm 1 lần" style="rounded=1;arcSize=6;verticalAlign=top;whiteSpace=wrap;html=1;fillColor=#F7F9FC;strokeColor=#9AA5B1;fontSize=14;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="450" y="110" width="220" height="450" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Trích header metadata&lt;/b&gt;&lt;br&gt;IP nguồn, độ dài IP, giao thức,&lt;br&gt;cờ SYN/ACK · KHÔNG đọc payload" style="rounded=1;arcSize=6;verticalAlign=top;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D98A00;fontSize=13;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="720" y="125" width="230" height="80" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Cửa sổ thời gian 1 giây&lt;/b&gt;&lt;br&gt;packet_rate · byte_rate&lt;br&gt;syn_count · ip_dispersion" style="rounded=1;arcSize=6;verticalAlign=top;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D98A00;fontSize=13;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="720" y="225" width="230" height="90" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;Random Forest (4 đặc trưng)&lt;/b&gt;&lt;br&gt;Xác suất tấn công ≥ 0,5&lt;br&gt;làm mượt: 2 cửa sổ bật / 3 tắt,&lt;br&gt;giữ nhãn tấn công ≥ 10 s" style="rounded=1;arcSize=6;verticalAlign=top;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D98A00;fontSize=13;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="720" y="335" width="230" height="100" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;Nhãn?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF1D6;strokeColor=#D98A00;fontSize=15;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="735" y="460" width="200" height="80" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;Module Tường lửa (nftables / iptables)&lt;/b&gt;&lt;br&gt;&lt;br&gt;Nhãn TẤN CÔNG → chặn IP nguồn&lt;br&gt;đáng ngờ (hoặc giới hạn tốc độ)&lt;br&gt;Phản ứng ≤ 3 giây&lt;br&gt;Luật đặt ở prerouting nên chặn&lt;br&gt;trước khi gói vào hàng đợi QoS" style="rounded=1;arcSize=6;verticalAlign=top;whiteSpace=wrap;html=1;fillColor=#FBE4E4;strokeColor=#C93A3A;fontSize=14;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1000" y="110" width="340" height="185" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;Module điều tiết QoS&lt;/b&gt;&lt;br&gt;nft đánh dấu (mark) theo cổng vào + DSCP&lt;br&gt;→ HTB trên gw-eth0.30 + FQ-CoDel mỗi lớp&lt;br&gt;&lt;br&gt;0x10 Báo cháy (DSCP 48): ≥10 Mbit, ưu tiên 0&lt;br&gt;0x11 Telemetry cảm biến: ≥5 Mbit, ưu tiên 1&lt;br&gt;0x12 Camera: ≥60 Mbit (trần 90), ưu tiên 2&lt;br&gt;0x13 Không tin cậy / gw-eth1: 1 Mbit (trần 10)" style="rounded=1;arcSize=6;verticalAlign=top;whiteSpace=wrap;html=1;fillColor=#E2F3E9;strokeColor=#1E8E4E;fontSize=13;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1000" y="325" width="340" height="265" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;live_metrics.json (mỗi 1 s)&lt;/b&gt;&lt;br&gt;timestamp, normal/syn/udp_packets,&lt;br&gt;rtt_ms, status, blocked_ips" style="rounded=1;arcSize=6;verticalAlign=top;whiteSpace=wrap;html=1;fillColor=#EDE7F6;strokeColor=#6A4FA3;fontSize=13;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="720" y="640" width="240" height="100" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;Máy chủ srv · VLAN 30&lt;/b&gt;&lt;br&gt;10.0.30.10&lt;br&gt;MQTT broker Mosquitto&lt;br&gt;Dashboard / cảnh báo" style="rounded=1;arcSize=6;verticalAlign=top;whiteSpace=wrap;html=1;fillColor=#E3EDFA;strokeColor=#2B6CB0;fontSize=14;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1400" y="400" width="190" height="130" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;Gói tấn công bị loại&lt;/b&gt;&lt;br&gt;(DROP)" style="rounded=1;arcSize=6;verticalAlign=top;whiteSpace=wrap;html=1;fillColor=#FBE4E4;strokeColor=#C93A3A;fontSize=14;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1400" y="150" width="190" height="90" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;Web Dashboard&lt;/b&gt;&lt;br&gt;Streamlit · localhost:8501&lt;br&gt;sơ đồ 4 tầng, biểu đồ,&lt;br&gt;nhật ký IP bị chặn" style="rounded=1;arcSize=6;verticalAlign=top;whiteSpace=wrap;html=1;fillColor=#EDE7F6;strokeColor=#6A4FA3;fontSize=13;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1400" y="640" width="190" height="100" as="geometry"/></mxCell><mxCell id="c22" value="" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#5B6570;fontColor=#5B6570;fontStyle=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="250" y="115" as="sourcePoint"/><mxPoint x="290" y="150" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c23" value="" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#5B6570;fontColor=#5B6570;fontStyle=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="250" y="250" as="sourcePoint"/><mxPoint x="290" y="200" as="targetPoint"/></mxGeometry></mxCe