#!/usr/sbin/nft -f
# Classify forwarded IPv4 traffic at the Gateway ingress. The mark survives
# routing and is consumed by the tc fw classifier on gw-eth0.30 egress.
# Mark map: 0x10=fire alarm, 0x11=sensor telemetry, 0x12=camera, 0x13=untrusted.
table inet qos {
    chain prerouting {
        type filter hook prerouting priority mangle; policy accept;

        # Fail closed into the lowest-priority class unless a trusted class matches.
        meta mark set 0x13

        # Internet/attacker-facing interface: always untrusted, regardless of spoofed source IP.
        iifname "gw-eth1" meta mark set 0x13

        # Camera VLAN.
        iifname "gw-eth0.20" meta mark set 0x12

        # Sensor VLAN: only DSCP 48 (CS6) is treated as an emergency alarm.
        iifname "gw-eth0.10" ip dscp 48 meta mark set 0x10
        iifname "gw-eth0.10" ip dscp != 48 meta mark set 0x11
    }
}
